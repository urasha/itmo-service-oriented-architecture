# POSIX shell. Local defaults, change paths and ports for your Helios account.
SOA_RUNTIME="$HOME/soa-lab3-runtime"
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
JETTY_HOME="$SOA_RUNTIME/jetty-home-12.0.40"
WILDFLY_HOME="$SOA_RUNTIME/wildfly-35.0.1.Final"
CONSUL_BIN="$SOA_RUNTIME/bin/consul"
HAPROXY_BIN=haproxy

# Public HTTPS ports on the server, then the two private Spring Boot ports.
FLATS_HTTPS_PORT=8443
AGENCY_HTTPS_PORT=8444
AGENCY_PORT_1=8445
AGENCY_PORT_2=8446

# WildFly binds loopback. Its HTTP remoting and management ports are 8080 and
# 9990 plus the offset. Apply the same offset to its other socket bindings.
WILDFLY_PORT_OFFSET=1000
EJB_POOL_MAX=16

# Consul single-node lab agent. All listeners bind to loopback.
CONSUL_HTTP_PORT=8500
CONSUL_RPC_PORT=8300
CONSUL_LAN_PORT=8301
CONSUL_WAN_PORT=8302
CONSUL_DNS_PORT=8600

# Addresses visible in the browser (also used with SSH local forwarding).
FLATS_PUBLIC_BASE_URL=https://localhost:8443
AGENCY_PUBLIC_BASE_URL=https://localhost:8444
AGENCY_ALLOWED_ORIGIN=https://localhost:8443
FLATS_ALLOWED_ORIGIN=https://localhost:8443
