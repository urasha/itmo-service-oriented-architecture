# Copy to deploy/local.env; fill paths and replace example ports with your assigned ports.
# POSIX shell syntax. No passwords: preparation generates private files outside the repository.
SOA_RUNTIME="$HOME/soa-74611-runtime"
JAVA_HOME='/path/to/compatible/jdk17'
JETTY_HOME="$SOA_RUNTIME/jetty-home-12.0.40"
JETTY_BASE="$SOA_RUNTIME/jetty-base"
PAYARA_HOME="$SOA_RUNTIME/payara6"
PAYARA_DOMAINS="$SOA_RUNTIME/payara-domains"
AGENCY_DOMAIN=agency

# All service ports, not just HTTPS, must be free and assigned to you.
FLATS_HTTPS_PORT=8443
AGENCY_HTTPS_PORT=8444
AGENCY_PORT_BASE=18000
AGENCY_ADMIN_PORT=18048
FLATS_BIND_ADDRESS=127.0.0.1
AGENCY_BIND_ADDRESS=127.0.0.1
FLATS_CERT_SAN='dns:localhost,ip:127.0.0.1'
AGENCY_CERT_SAN='dns:localhost,ip:127.0.0.1'

# Browser endpoints in SSH-tunnel mode (local forwarded ports can differ from remote ports).
FLATS_PUBLIC_BASE_URL='https://localhost:8443'
AGENCY_PUBLIC_BASE_URL='https://localhost:8444'
AGENCY_ALLOWED_ORIGIN='https://localhost:8443'
# Server-to-server endpoint on Helios; never substitute a browser-only local tunnel here.
FLATS_INTERNAL_URL="https://localhost:$FLATS_HTTPS_PORT"
# Probe only; change to the server SAN hostname if Payara binds a specific external address.
AGENCY_PROBE_URL="https://localhost:$AGENCY_HTTPS_PORT"
FLATS_PUBLIC_URL="$FLATS_PUBLIC_BASE_URL"
FLATS_CERTIFICATE="$JETTY_BASE/etc/flats.crt"
